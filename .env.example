# Copy to ignored .env; an empty key keeps deterministic local fallback enabled.
# Use a Mubit project API key, never a direct model-provider key.
MUBIT_API_KEY=
MUBIT_MODEL=gpt-6-luna
MUBIT_TIMEOUT_MS=15000
# Maximum gateway attempts per director process; reset does not replenish this budget.
MUBIT_MAX_CALLS=120
# Keep the default gateway. Other origins/providers are deliberately rejected.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
