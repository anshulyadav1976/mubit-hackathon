# Copy to ignored .env; an empty key keeps deterministic local fallback enabled.
# Mubit takes a project key; its upstream provider credentials stay in the Mubit console.
MUBIT_API_KEY=
MUBIT_MODEL=gpt-6-luna
MUBIT_TIMEOUT_MS=15000
# Maximum gateway attempts per director process; reset does not replenish this budget.
MUBIT_MAX_CALLS=120
# Keep the default gateway. Other origins/providers are deliberately rejected.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
# Optional hosted NPC TTS only; this key is never used for story-text inference.
# Never place this key in the Minecraft client.
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts

# Expressive hosted character voices; use macos for local synthesis instead.
EVERAFTER_TTS_PROVIDER=openrouter
